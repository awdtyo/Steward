# Copy to .env and fill in. Never commit .env (see .gitignore).
# All LLM endpoints, model names, and secrets come from env vars. Never hardcode.

# OpenAI-compatible LLM API (e.g. NVIDIA Nemotron endpoint)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=

# Model routing: Nano = triage, Super = planning, Ultra = hard/ambiguous
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Optional per-1K-token prices in USD for cost logging (0 = track tokens only)
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# Redaction overrides: comma-separated literals (deny always redacted,
# e.g. tailnet peer short names or protected service names; allow survives)
REDACT_ALLOW=
REDACT_DENY=vaultwarden

# Outgoing mail for approvals/alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=steward@example.com
ALERT_TO=admin@example.com

# Optional external healthcheck ping URL
HEALTHCHECK_URL=

# Dashboard base URL used for incident links in alert emails
DASHBOARD_BASE_URL=http://localhost:8000

# Dashboard listen port (always bound to 127.0.0.1) and SQLite path
PORT=8000
STEWARD_DB=data/steward.db

# Action layer: Tier-1 auto-fix allowlist (comma-separated service names).
# Vaultwarden can never be allowlisted: code rejects it regardless.
TIER1_ALLOW_SERVICES=jellyfin,nextcloud

# Human approver identity for Tier-2 actions (must match the Tailscale
# Serve identity header below). Empty = approvals fail closed (deny all).
ALLOWED_APPROVER=admin@example.com
TAILSCALE_USER_HEADER=Tailscale-User-Login

# Compose file snapshotted before Tier-2 actions and restored on rollback
COMPOSE_PATH=docker-compose.yml

# Service definitions (see services.example.yaml). Local topology stays
# out of git: services.yaml is gitignored.
SERVICES_PATH=services.yaml

# Directory holding encrypted Vaultwarden backups checked by the backup
# verifier. Empty = check skipped. Only status (never paths) leaves this box.
VAULTWARDEN_BACKUP_DIR=

# Dry-run mode: use mock events/logs, touch nothing real (true/false)
DRY_RUN=false
