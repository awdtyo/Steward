# Copy to .env and fill in. Never commit .env (see .gitignore).
# All LLM endpoints, model names, and secrets come from env vars. Never hardcode.

# OpenAI-compatible LLM API (e.g. NVIDIA Nemotron endpoint)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=

# Model routing: Nano = triage, Super = planning, Ultra = hard/ambiguous
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Outgoing mail for approvals/alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=steward@example.com
ALERT_TO=admin@example.com

# Optional external healthcheck ping URL
HEALTHCHECK_URL=

# Dry-run mode: use mock events/logs, touch nothing real (true/false)
DRY_RUN=false
